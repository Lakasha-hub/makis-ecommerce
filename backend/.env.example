PORT=3000
NODE_ENV=development
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/makis?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# SMTP — Resend (https://resend.com)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_TU_API_KEY_AQUI
# Sin dominio propio: usar onboarding@resend.dev (solo env dev)
EMAIL_FROM=onboarding@resend.dev
